
# Server Configuration
PORT=5000
NODE_ENV=development

# Security
JWT_SECRET=generate-a-secure-random-string-here

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/whisp-chat
MONGODB_DB_NAME=whisp-chat

# Redis Configuration (Required)
REDIS_URL=redis://localhost:6379

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Twilio Configuration (Required)
TWILIO_ACCOUNT_SID=your-twilio-account-sid-here
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_PHONE_NUMBER=your-twilio-whatsapp-number
TWILIO_CONTENT_SID=your-twilio-content-sid-here

# Note: In production, never commit the actual .env file
# Generate secure values for all credentials
# Store production credentials in a secure vault or environment management system

